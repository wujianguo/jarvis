# ------------------------------------------------------------
# Jarvis - Environment Variables Example
# Copy this file to .env.local and fill in values.
# ------------------------------------------------------------

# Server
PORT=9000

# ------------------------------------------------------------
# KV service (optional but recommended)
# Used to cache Feishu tenant_access_token and WeCom access_token to reduce API calls.
# Also used by SMS dedup (sms:ingest:dedup:*).
# ------------------------------------------------------------
KV_BASE_URL=
KV_API_TOKEN=

# ------------------------------------------------------------
# Feishu (Lark) Open Platform (required for Feishu integrations)
# ------------------------------------------------------------
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# Webhook path (optional). The app uses /api prefix by default.
FEISHU_WEBHOOK_PATH=/api/feishu/webhook

# ------------------------------------------------------------
# Feishu Bitable
# Map "database name" -> { appToken, tables: { "tableName": { "tableId": "..." } } }
# The "tables" field maps logical table names to Bitable tableIds.
# Example:
# FEISHU_BITABLE_DATABASES_JSON={"home":{"appToken":"bascnxxxx","tables":{"express_pickups":{"tableId":"tblxxxx"},"express_assignees":{"tableId":"tblxxxx"}}}}
# ------------------------------------------------------------
FEISHU_BITABLE_DATABASES_JSON={}

# ------------------------------------------------------------
# Feishu Sheets export (optional)
# Used by FeishuSheetsService.appendExportRows / FeishuStorageService.exportLog.append
# ------------------------------------------------------------
FEISHU_SHEETS_EXPORT_SPREADSHEET_TOKEN=
FEISHU_SHEETS_EXPORT_SHEET_ID=

# ------------------------------------------------------------
# AI (Vercel AI SDK + Cloudflare AI Gateway) — required for SMS ingest classification
# ------------------------------------------------------------
# Cloudflare account ID for AI Gateway
CLOUDFLARE_ACCOUNT_ID=

# AI Gateway name
GATEWAY_NAME=

# Cloudflare AI Gateway token
CF_AIG_TOKEN=

# ------------------------------------------------------------
# SMS ingest
# ------------------------------------------------------------
# Deduplication TTL in seconds (default: 120)
# Requests with the same fingerprint within this window are rejected as duplicates.
SMS_DEDUP_TTL_SECONDS=120

# ------------------------------------------------------------
# WeCom (企业微信) self-built application
# Required for WeCom messaging and webhook callback features.
# ------------------------------------------------------------

# WeCom API base URL (optional, default: https://qyapi.weixin.qq.com)
WECOM_BASE_URL=https://qyapi.weixin.qq.com

# WeCom Corp ID (企业ID) — found in WeCom admin panel > My Corporation
WECOM_CORP_ID=

# WeCom Corp Secret (应用的Secret) — found in WeCom admin panel > App > App Details
WECOM_CORP_SECRET=

# WeCom Agent ID (应用AgentId) — found in WeCom admin panel > App > App Details
WECOM_AGENT_ID=

# Callback Token (回调Token) — set in WeCom admin panel > App > Receive Messages > API Receive
# Used to verify incoming callback requests.
WECOM_TOKEN=

# EncodingAESKey (消息加解密密钥) — set in WeCom admin panel > App > Receive Messages > API Receive
# 43-character Base64 key used to decrypt encrypted callback messages.
WECOM_ENCODING_AES_KEY=


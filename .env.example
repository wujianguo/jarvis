# ------------------------------------------------------------
# Jarvis - Environment Variables Example
# Copy this file to .env.local and fill in values.
# ------------------------------------------------------------

# Server
PORT=9000

# ------------------------------------------------------------
# KV service (optional but recommended)
# Used to cache Feishu tenant_access_token to reduce API calls.
# Also used by SMS dedup (sms:ingest:dedup:*).
# ------------------------------------------------------------
KV_BASE_URL=
KV_API_TOKEN=

# ------------------------------------------------------------
# Feishu (Lark) Open Platform (required for Feishu integrations)
# ------------------------------------------------------------
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# Webhook path (optional). The app uses /api prefix by default.
FEISHU_WEBHOOK_PATH=/api/feishu/webhook

# ------------------------------------------------------------
# Feishu Bitable
# Map "database name" -> { appToken, tables: { "tableName": { "tableId": "..." } } }
# The "tables" field maps logical table names to Bitable tableIds.
# Example:
# FEISHU_BITABLE_DATABASES_JSON={"home":{"appToken":"bascnxxxx","tables":{"express_pickups":{"tableId":"tblxxxx"},"express_assignees":{"tableId":"tblxxxx"}}}}
# ------------------------------------------------------------
FEISHU_BITABLE_DATABASES_JSON={}

# ------------------------------------------------------------
# Feishu Sheets export (optional)
# Used by FeishuSheetsService.appendExportRows / FeishuStorageService.exportLog.append
# ------------------------------------------------------------
FEISHU_SHEETS_EXPORT_SPREADSHEET_TOKEN=
FEISHU_SHEETS_EXPORT_SHEET_ID=

# ------------------------------------------------------------
# AI (Vercel AI SDK + OpenAI) — required for SMS ingest classification
# ------------------------------------------------------------
# OpenAI API key (required for SMS ingest AI classification)
OPENAI_API_KEY=

# Model to use for SMS classification (default: gpt-4o-mini)
AI_MODEL=gpt-4o-mini

# Optional: override OpenAI base URL (e.g. for Azure OpenAI or local models)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------
# SMS ingest
# ------------------------------------------------------------
# Deduplication TTL in seconds (default: 120)
# Requests with the same fingerprint within this window are rejected as duplicates.
SMS_DEDUP_TTL_SECONDS=120

